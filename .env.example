# ============================================================
#  Local Literature Agent - configuration template
#  Copy this file to ".env" and adjust what you need.
#  NOTE: keep this file ASCII-only (encoding-safe on Windows).
#  使用：复制为 .env 后按需修改；不配置也能跑（用默认值 + 本地 Ollama）
# ============================================================

# ---------- LLM ----------
# ollama = 本地模型（默认，免费）；openai = 任意 OpenAI 兼容接口
LLM_PROVIDER=ollama
LOCAL_LLM=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434

# ---------- 云端模型（可选） ----------
# 把 LLM_PROVIDER 改成 openai 后生效：
#   DeepSeek : LIT_API_BASE=https://api.deepseek.com/v1   LOCAL_LLM=deepseek-chat
#   OpenAI   : LIT_API_BASE=https://api.openai.com/v1     LOCAL_LLM=gpt-4o-mini
#   通义千问 : LIT_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1  LOCAL_LLM=qwen-plus
# 也可以不写在这里，直接在网页界面左侧临时填写。
LIT_API_KEY=
LIT_API_BASE=https://api.deepseek.com/v1

# ---------- 文献检索 ----------
# 检索年份下限；0 或留空 = 不限
LIT_YEAR_FROM=2019
# 是否检索 arXiv 预印本：0=不检索（默认，综述引用只用正式发表来源）；1=检索
LIT_INCLUDE_PREPRINTS=0
# OpenAlex 可选 key（不填也能用 Crossref + DOAJ；申请见 https://openalex.org/）
LIT_OPENALEX_KEY=
# 建议填自己的邮箱，进 OpenAlex polite pool（可选）
LIT_MAILTO=
# 每轮精读几篇（3B 建议 3-5，7B / 云端可 6-8）
LIT_PAPERS_PER_ROUND=5
# 研究轮数：1 快 / 2 标准 / 3 深挖
LIT_ROUNDS=2
# 是否下载 arXiv 全文精读（更慢更准）
LIT_READ_FULLTEXT=false
# 输出语言：zh / en
LIT_LANGUAGE=zh

# ---------- 检索约束（v2） ----------
# soft = 同义词扩展 + 软惩罚（默认）；hard = 缺失核心概念直接淘汰（v1）；off = 不约束
LIT_CONSTRAINT_MODE=soft

# ---------- 引用核验 ----------
# 编号有效性 + 数字回查（秒级、确定性），建议开
LIT_VERIFY_CITATIONS=true
# 语义抽检：模型逐句判断，3B 噪声大，默认关
LIT_VERIFY_SEMANTIC=false
# 语义抽检抽几句
LIT_VERIFY_SENTENCES=6
